// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String        @id
  name                      String?
  email                     String        @unique
  githubUsername            String?       @unique
  githubConnected           Boolean       @default(false)
  githubConnectionReference String?
  createdAt                 DateTime      @default(now())
  projects                  Project[]
  chatSessions              ChatSession[]
  sandboxSessions           SandboxSession[]
  agentRuns                 AgentRun[]
}

model Project {
  id              String           @id @default(cuid())
  repoName        String
  repoOwner       String
  userId          String
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatSessions    ChatSession[]
  sandboxSessions SandboxSession[]
  agentRuns       AgentRun[]

  @@unique([userId, repoOwner, repoName])
}

model ChatSession {
  id          String        @id @default(cuid())
  projectId   String
  userId      String
  issueNumber Int
  title       String?
  status      String        @default("active")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
  agentRuns   AgentRun[]

  @@unique([projectId, issueNumber])
  @@index([userId])
}

model AgentRun {
  id                 String          @id @default(cuid())
  userId             String
  projectId          String
  chatSessionId      String?
  issueNumber        Int
  issueTitle         String?
  mode               String
  provider           String
  requestedModel     String
  resolvedModel      String?
  status             String          @default("running")
  instructionPreview String?
  failureCode        String?
  promptTokens       Int             @default(0)
  completionTokens   Int             @default(0)
  reasoningTokens    Int?
  totalTokens        Int             @default(0)
  costUsd            Decimal?        @db.Decimal(12, 8)
  stepsUsed          Int             @default(0)
  durationMs         Int?
  startedAt          DateTime        @default(now())
  completedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chatSession        ChatSession?     @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  events             AgentRunEvent[]

  @@index([userId, startedAt])
  @@index([projectId, startedAt])
  @@index([requestedModel, startedAt])
  @@index([status, startedAt])
}

model AgentRunEvent {
  id               String   @id @default(cuid())
  runId            String
  sequence         Int
  step             Int?
  type             String
  level            String   @default("info")
  phase            String?
  model            String?
  toolCallId       String?
  toolName         String?
  status           String?
  paths            String[] @default([])
  durationMs       Int?
  promptTokens     Int?
  completionTokens Int?
  reasoningTokens  Int?
  totalTokens      Int?
  costUsd          Decimal? @db.Decimal(12, 8)
  payload          Json
  createdAt        DateTime @default(now())
  run              AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, createdAt])
  @@index([toolName, createdAt])
  @@index([type, createdAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      String
  body      String
  tone      String?
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model SandboxSession {
  sessionId       String   @id
  sandboxId       String   @unique
  userId          String
  projectId       String   @unique
  previewUrl      String
  lastHeartbeatAt DateTime
  startedAt       DateTime
  isStopped       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
}
